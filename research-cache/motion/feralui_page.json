kFolio page. The @import stays for the\n         standalone component; once these are cached it's a free hit. -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&amp;family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&amp;family=Inter:opsz,wght@14..32,400..900&amp;family=Quicksand:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\">\n\n    <!-- Structured data: describes the site and enumerates the real components so search\n         engines understand what each route is. Keep in sync with HOME_ENTRIES in App.tsx. -->\n    <script type=\"application/ld+json\">\n      {\n        \"@context\": \"https://schema.org\",\n        \"@graph\": [\n          {\n            \"@type\": \"WebSite\",\n            \"@id\": \"https://feralui.dev/#website\",\n            \"url\": \"https://feralui.dev/\",\n            \"name\": \"FeralUI\",\n            \"description\": \"A small library of playful, physics-driven React elements: a ceiling pull-cord with a real Verlet rope, a claw-machine captcha, and more.\",\n            \"inLanguage\": \"en\",\n            \"author\": { \"@id\": \"https://feralui.dev/#author\" }\n          },\n          {\n            \"@type\": \"Person\",\n            \"@id\": \"https://feralui.dev/#author\",\n            \"name\": \"Sarthak Navalekar\",\n            \"alternateName\": \"mortspace\",\n            \"url\": \"https://github.com/mortspace\",\n            \"sameAs\": [\n              \"https://www.linkedin.com/in/sarthak-navalekar/\",\n              \"https://github.com/mortspace\",\n              \"https://www.npmjs.com/~moratspace\",\n              \"https://x.com/SolutionB2u\",\n              \"https://dribbble.com/Solution-B\"\n            ]\n          },\n          {\n            \"@type\": \"ItemList\",\n            \"name\": \"FeralUI components\",\n            \"itemListOrder\": \"https://schema.org/ItemListUnordered\",\n            \"itemListElement\": [\n              { \"@type\": \